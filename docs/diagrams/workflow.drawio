<?xml version="1.0" encoding="UTF-8"?>
<mxfile>
  <diagram id="3d-workflow" name="3D Generation Workflow">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ===== PIPELINE STEPS (blue) ===== -->
        <mxCell id="10" value="&lt;b&gt;Upload Photos&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="&lt;b&gt;Extract Equipment&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;VLM object detection&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="12" value="&lt;b&gt;Estimate Pose &amp;amp; Size&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;CV + heuristics&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="13" value="&lt;b&gt;Match Asset&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;library lookup + fallback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="14" value="&lt;b&gt;Resolve Layout&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;constraint-based solver&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="15" value="&lt;b&gt;Assemble 3D Scene&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;composite + export GLB&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="530" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- ===== EVALUATION (yellow) ===== -->
        <mxCell id="16" value="&lt;b&gt;Evaluate Scene&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;VLM vs original photos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="530" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- ===== DECISION DIAMOND (orange) ===== -->
        <mxCell id="17" value="&lt;b&gt;Score &amp;ge; 0.8?&lt;/b&gt;" style="shape=diamond;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="630" width="120" height="80" as="geometry"/>
        </mxCell>

        <!-- ===== CORRECTION LOOP (red) ===== -->
        <mxCell id="18" value="&lt;b&gt;Generate Feedback&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;issue analysis + fix plan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="760" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="19" value="&lt;b&gt;Apply Fixes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;targeted re-run pipeline&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="850" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- ===== OUTPUT (green) ===== -->
        <mxCell id="20" value="&lt;b&gt;Review with User&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;preview + eval report&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="530" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="21" value="&lt;b&gt;Final Scene&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Digital Twin Ready &amp;#10003;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="630" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- ===== PIPELINE EDGES (blue arrows down) ===== -->
        <mxCell id="100" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=blockThin;endFill=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="10" target="11">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="101" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=blockThin;endFill=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="11" target="12">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="102" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=blockThin;endFill=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="12" target="13">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="103" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=blockThin;endFill=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="13" target="14">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="104" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=blockThin;endFill=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="14" target="15">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== ASSEMBLE → EVALUATE (horizontal) ===== -->
        <mxCell id="105" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=blockThin;endFill=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="15" target="16">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== EVALUATE → DECISION ===== -->
        <mxCell id="106" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=blockThin;endFill=1;strokeColor=#d6b656;" edge="1" parent="1" source="16" target="17">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== YES PATH (Decision → Review) ===== -->
        <mxCell id="107" value="&lt;b&gt;YES&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=blockThin;endFill=1;strokeColor=#82b366;fontSize=12;" edge="1" parent="1" source="17" target="20">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="500" y="670"/>
              <mxPoint x="500" y="555"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ===== NO PATH (Decision → Feedback) ===== -->
        <mxCell id="108" value="&lt;b&gt;NO&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=blockThin;endFill=1;strokeColor=#b85450;fontSize=12;" edge="1" parent="1" source="17" target="18">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== FEEDBACK → APPLY ===== -->
        <mxCell id="109" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=blockThin;endFill=1;strokeColor=#b85450;" edge="1" parent="1" source="18" target="19">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== ITERATE LOOP (Apply → Assemble) ===== -->
        <mxCell id="110" value="&lt;b&gt;iterate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;max 3 retries&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;endArrow=blockThin;endFill=1;strokeColor=#b85450;dashed=1;fontSize=12;" edge="1" parent="1" source="19" target="15">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="530" y="875"/>
              <mxPoint x="530" y="580"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ===== REVIEW → FINAL SCENE ===== -->
        <mxCell id="111" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=blockThin;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="20" target="21">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="system-arch" name="System Architecture">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ===== TITLE ===== -->
        <mxCell id="30" value="&lt;b&gt;AI Twin Factory - System Architecture&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="10" width="600" height="40" as="geometry"/>
        </mxCell>

        <!-- ===== LAYER 1: Frontend ===== -->
        <mxCell id="31" value="&lt;b&gt;Frontend Layer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#fff&quot;&gt;React + Three.js + WebSocket&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#4a6a9f;fontSize=12;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="100" y="70" width="600" height="50" as="geometry"/>
        </mxCell>

        <!-- Arrow down -->
        <mxCell id="32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=blockThin;endFill=1;strokeColor=#666666;exitPerimeter=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="120" as="sourcePoint"/>
            <mxPoint x="400" y="140" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ===== LAYER 2: API Gateway ===== -->
        <mxCell id="33" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#fff&quot;&gt;REST API + WebSocket&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9673a6;strokeColor=#79598a;fontSize=12;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="100" y="140" width="600" height="40" as="geometry"/>
        </mxCell>

        <!-- Arrow down -->
        <mxCell id="34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="180" as="sourcePoint"/>
            <mxPoint x="400" y="200" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ===== LAYER 3: AI Agents (highlighted) ===== -->
        <mxCell id="35" value="&lt;b&gt;AI Agent Layer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#fff&quot;&gt;Orchestrator | Vision Pipeline | 3D Pipeline | Critic&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#b87e00;fontSize=12;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="100" y="200" width="600" height="50" as="geometry"/>
        </mxCell>

        <!-- Sub-nodes inside Layer 3 -->
        <mxCell id="36" value="Orchestrator&lt;br&gt;(LangGraph)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="260" width="130" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="37" value="Vision Pipeline&lt;br&gt;(VLM + YOLO)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="270" y="260" width="130" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="38" value="3D Pipeline&lt;br&gt;(Assemble + Export)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="260" width="130" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="39" value="Critic&lt;br&gt;(Self-Evaluation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="570" y="260" width="110" height="40" as="geometry"/>
        </mxCell>

        <!-- Arrow down -->
        <mxCell id="40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="300" as="sourcePoint"/>
            <mxPoint x="400" y="330" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ===== LAYER 4: Analytics ===== -->
        <mxCell id="41" value="&lt;b&gt;Processing &amp;amp; Analytics&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#fff&quot;&gt;Anomaly Detection | Sensor Fusion | Predictive&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#9a3d3a;fontSize=12;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="100" y="330" width="600" height="50" as="geometry"/>
        </mxCell>

        <!-- Arrow down -->
        <mxCell id="42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="380" as="sourcePoint"/>
            <mxPoint x="400" y="410" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ===== LAYER 5: Data ===== -->
        <mxCell id="43" value="&lt;b&gt;Data Layer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#fff&quot;&gt;PostgreSQL | InfluxDB (Time-series) | Vector DB (Assets)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#5e9b4a;fontSize=12;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="100" y="410" width="600" height="50" as="geometry"/>
        </mxCell>

        <!-- Arrow down -->
        <mxCell id="44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=blockThin;endFill=1;strokeColor=#666666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="460" as="sourcePoint"/>
            <mxPoint x="400" y="490" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ===== LAYER 6: IoT ===== -->
        <mxCell id="45" value="&lt;b&gt;IoT / Sensor Layer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#fff&quot;&gt;Temperature | Vibration | Pressure | Camera Feed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4a7a9a;strokeColor=#3a5f7a;fontSize=12;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="100" y="490" width="600" height="50" as="geometry"/>
        </mxCell>

        <!-- ===== SIDE LABEL: Tech Stack ===== -->
        <mxCell id="46" value="&lt;b&gt;Tech Stack&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&amp;#8226; FastAPI + NestJS&lt;br&gt;&amp;#8226; React + Three.js&lt;br&gt;&amp;#8226; Qwen2-VL / LLaVA&lt;br&gt;&amp;#8226; LangGraph&lt;br&gt;&amp;#8226; PyTorch / sklearn&lt;br&gt;&amp;#8226; Ollama (local VLM)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="740" y="70" width="160" height="200" as="geometry"/>
        </mxCell>

        <!-- ===== LEGEND ===== -->
        <mxCell id="47" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&amp;#9632; &lt;/font&gt; Frontend&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&amp;#9632; &lt;/font&gt; API Gateway&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#d79b00&quot;&gt;&amp;#9632; &lt;/font&gt;&lt;font style=&quot;font-size:10px&quot;&gt; AI Agents&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#b85450&quot;&gt;&amp;#9632; &lt;/font&gt;&lt;font style=&quot;font-size:10px&quot;&gt; Analytics&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#82b366&quot;&gt;&amp;#9632; &lt;/font&gt;&lt;font style=&quot;font-size:10px&quot;&gt; Data&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4a7a9a&quot;&gt;&amp;#9632; &lt;/font&gt;&lt;font style=&quot;font-size:10px&quot;&gt; IoT / Sensors&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="740" y="290" width="160" height="160" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
